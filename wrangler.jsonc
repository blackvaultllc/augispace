
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ip-intelligence-terminal-design-xf",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-12",
  // nodejs_compat is required for Node APIs used by the application.
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext uses this service for ISR and revalidation.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ip-intelligence-terminal-design-xf"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6c27d424333545dcbd9d122224c409a3",
      "localConnectionString": "postgres://localdev:localdev@127.0.0.1:5432/localdev"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "augi.space",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Preserve variables configured in the Cloudflare dashboard.
  "keep_vars": true,
  "vars": {
    "BETTER_AUTH_URL": "https://augi.space",
    "GOOGLE_CLIENT_ID": "660280240040-s8aeejbip9gr636ujegv970v2j9sdj1o.apps.googleusercontent.com",
    "NEXT_PUBLIC_SUPABASE_URL": "https://mlkryxtiknlccksokpse.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_-kEJcyE50uN8oORyL8gfjg_XOLyIvL9",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_-kEJcyE50uN8oORyL8gfjg_XOLyIvL9"
  }
}
